# Configuración development. Copiar a .env y completar localmente; nunca versionar secretos.
APP_ENV=development
# Logging técnico estructurado. LOG_OUTPUT admite stdout o stderr.
LOG_LEVEL=INFO
LOG_OUTPUT=stderr
N8N_LOG_LEVEL=info
# Política portable del driver Docker para todos los servicios Compose.
DOCKER_LOG_DRIVER=json-file
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_BOOTSTRAP_USER=leadflow_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=
# Solo para reparar un volumen donde POSTGRES_MIGRATOR_USER es el bootstrap histórico OID 10.
# Definir temporalmente con ese usuario; la reparación multisesión lo renombra a bootstrap y luego retirar.
POSTGRES_ROLE_SYNC_USER=
POSTGRES_MIGRATOR_USER=leadflow_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=
CRM_BASE_URL=
CRM_PROVIDER=mock
CRM_API_KEY=
ENRICHMENT_BASE_URL=
ENRICHMENT_PROVIDER=mock
ENRICHMENT_API_KEY=
HUBSPOT_PROPERTY_INDUSTRY=industry
HUBSPOT_PROPERTY_COMPANY_SIZE=leadflow_company_size
HUBSPOT_PROPERTY_WEBSITE=website
SLACK_WEBHOOK_URL=
N8N_PORT=5680
N8N_ENCRYPTION_KEY=
LEADFLOW_WEBHOOK_KEY=
# Sources separados por coma; case exacto, sin lowercase silencioso, patrón [A-Za-z0-9_-]{1,100}.
LEADFLOW_ALLOWED_SOURCES=website
# HMAC mínimo de 32 caracteres para tombstones DSR; secreto externo a Git.
DSR_SUBJECT_KEY=
RECOVERY_CONTEXT_KEY=
# Máximo técnico sin progreso: entre 60 y 604800 segundos (7 días).
RECOVERY_MAX_PROCESSING_AGE_SECONDS=604800
RETENTION_SUCCESS_DAYS=90
RETENTION_FAILED_DAYS=180
RETENTION_PROCESSING_DAYS=7
RETENTION_PURGE_BATCH_SIZE=1000
# Intentos totales por operación, incluido el primero.
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_FIRST_SECONDS=5
RETRY_DELAY_SECOND_SECONDS=15
ADAPTER_HTTP_TIMEOUT_MS=2000
ADAPTER_CALL_TIMEOUT_MS=30000
ADAPTER_PORT=5685
RECOVERY_ADAPTER_URL=http://127.0.0.1:5685
# Identidad service-to-service del Core/recovery ante el Adapter; mínimo 32 caracteres.
ADAPTER_SERVICE_KEY=
ADAPTER_ALLOWED_OPERATIONS=crm.process,crm.update_enrichment,crm.record_interaction,crm.reconcile_interaction,enrichment.enrich,alert.send,crm.capabilities
CRM_CAP_CONSISTENT_LOOKUP_AFTER_CREATE=true
CRM_CAP_UNIQUE_EMAIL=true
CRM_CAP_IDEMPOTENT_CREATE_OPERATION_KEY=true
CRM_CAP_CONFLICT_RECONCILIATION=true
CRM_CAP_INTERACTION_WRITE=true
CRM_CAP_INTERACTION_IDEMPOTENCY=true
CRM_CAP_INTERACTION_RECONCILIATION=true
# Catálogo externalizable; coincidencia exacta tras trim, separado por comas.
LEADFLOW_ALLOWED_INTERESTS=producto_a

# Production se valida con scripts/validation/validate_deployment_config.py y
# compose.production.yaml. Definir fuera de Git; no reutilizar endpoints mock/locales.
PUBLIC_WEBHOOK_HOST=
CRM_UPSTREAM_URL=
ENRICHMENT_UPSTREAM_URL=
# LF-002.5 production: CRM_PROVIDER=hubspot, ENRICHMENT_PROVIDER=hunter.
# URLs oficiales previstas: https://api.hubapi.com y https://api.hunter.io.
