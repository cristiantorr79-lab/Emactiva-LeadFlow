        "jsCode": "const source=$('Authenticate Validate Normalize').item.json; const headers={'X-LeadFlow-Adapter-Key':$env.ADAPTER_SERVICE_KEY}; const timeout=Math.max(1,Number($env.ADAPTER_CALL_TIMEOUT_MS||30000)); try{if(source.interaction){const caps=await helpers.httpRequest({method:'GET',url:$env.CRM_ADAPTER_URL+'/crm/capabilities',headers,json:true,timeout});if(!caps.interaction_write||!caps.interaction_idempotency||!caps.interaction_reconciliation)return {json:{success:false,stage:'crm_interaction',error_type:'authorization_error',error_code:'interaction_capability_missing',retry_count:0}};} const result=await helpers.httpRequest({method:'POST',url:$env.CRM_ADAPTER_URL+'/crm/process',headers,body:{email:source.email,lead:source.lead,present_fields:source.crm_fields,operation_key:source.idempotency_key+':crm_create'},json:true,timeout}); return {json:result};}catch(error){return {json:{success:false,stage:'crm_lookup',error_type:'upstream_error',error_code:'adapter_unavailable',retry_count:0}};}"
