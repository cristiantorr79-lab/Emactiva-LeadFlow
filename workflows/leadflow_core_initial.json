        "jsCode": "const source=$('Authenticate Validate Normalize').item.json; try{const result=await helpers.httpRequest({method:'POST',url:$env.CRM_ADAPTER_URL+'/crm/process',body:{email:source.email,lead:source.lead,present_fields:source.crm_fields,operation_key:source.idempotency_key+':crm_create'},json:true,timeout:Math.max(1,Number($env.ADAPTER_CALL_TIMEOUT_MS||30000))}); return {json:result};}catch(error){return {json:{success:false,stage:'crm_lookup',error_type:'upstream_error',error_code:'adapter_unavailable',retry_count:0}};}"
