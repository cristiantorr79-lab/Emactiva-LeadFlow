      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto=require('crypto'); const headers=$json.headers||{}; const body=$json.body; const executionId='lf_exec_'+crypto.randomUUID().replace(/-/g,''); const expected=String($env.LEADFLOW_WEBHOOK_KEY||''); const supplied=String(headers['x-leadflow-key']||''); const authenticated=expected.length>0&&supplied.length===expected.length&&crypto.timingSafeEqual(Buffer.from(supplied),Buffer.from(expected)); if(!authenticated)return{json:{route:'auth_error',execution_id:executionId}}; const contentType=String(headers['content-type']||'').toLowerCase(); if(!contentType.startsWith('application/json'))return{json:{route:'validation_error',execution_id:executionId,error_code:'content_type'}}; let code=''; if(!body||typeof body!=='object'||Array.isArray(body))code='invalid_json'; else if(!Object.prototype.hasOwnProperty.call(body,'event_id')||!Object.prototype.hasOwnProperty.call(body,'source')||!Object.prototype.hasOwnProperty.call(body,'lead')||!body.lead||!Object.prototype.hasOwnProperty.call(body.lead,'email'))code='missing_field'; else if(typeof body.event_id!=='string'||typeof body.source!=='string'||typeof body.lead!=='object'||Array.isArray(body.lead)||typeof body.lead.email!=='string'||(Object.prototype.hasOwnProperty.call(body,'interaction')&&(body.interaction===null||typeof body.interaction!=='object'||Array.isArray(body.interaction))))code='invalid_type'; else{const eventId=body.event_id; const source=body.source; const allowed=String($env.LEADFLOW_ALLOWED_SOURCES||'').split(',').filter(value=>/^[A-Za-z0-9_-]{1,100}$/.test(value)); if(eventId.length<1||eventId.length>200||eventId!==eventId.trim())code='invalid_event_id'; else if(!/^[A-Za-z0-9_-]{1,100}$/.test(source)||!allowed.includes(source))code='invalid_source'; else{const email=body.lead.email.trim().toLowerCase(); const parts=email.split('@'); const labels=parts.length===2?parts[1].split('.'):[]; if(email.length>254||/\\s/.test(email)||parts.length!==2||!parts[0]||labels.length<2||labels.some(label=>!label))code='invalid_email'; else{for(const field of ['first_name','last_name','phone','company'])if(Object.prototype.hasOwnProperty.call(body.lead,field)&&(typeof body.lead[field]!=='string'||body.lead[field].length>200))code='invalid_optional_field'; const interaction={}; if(!code&&body.interaction)for(const [field,limit] of [['interest',100],['message',2000]])if(Object.prototype.hasOwnProperty.call(body.interaction,field)){const value=body.interaction[field];if(typeof value!=='string')code='invalid_interaction';else{const trimmed=value.trim();if(trimmed.length>limit)code='invalid_interaction';else if(trimmed)interaction[field]=trimmed;}} const allowedInterests=String($env.LEADFLOW_ALLOWED_INTERESTS||'').split(',').map(value=>value.trim()).filter(Boolean); if(!code&&interaction.interest&&!allowedInterests.includes(interaction.interest))code='invalid_interest'; if(!code){const sha=value=>crypto.createHash('sha256').update(value,'utf8').digest('hex'); const subjectKey=String($env.DSR_SUBJECT_KEY||''); if(subjectKey.length<32)return{json:{route:'validation_error',execution_id:executionId,error_code:'dsr_configuration'}}; const subjectToken=crypto.createHmac('sha256',subjectKey).update(email,'utf8').digest('hex'); const lead={email},crm_fields={}; for(const field of ['first_name','last_name','phone','company'])if(body.lead[field]){lead[field]=body.lead[field];crm_fields[field]=body.lead[field];} return{json:{route:'valid',execution_id:executionId,event_id:eventId,source,lead_identifier:sha(email),idempotency_key:sha(source+':'+eventId),subject_token:subjectToken,email,lead,crm_fields,...(Object.keys(interaction).length?{interaction}:{})}};}}}} return{json:{route:'validation_error',execution_id:executionId,error_code:code}};"
