      "id": "prepare",
      "name": "Authenticate Validate Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto=require('crypto'); const headers=$json.headers||{}; const body=$json.body; const executionId='lf_exec_'+crypto.randomUUID().replace(/-/g,''); const expected=String($env.LEADFLOW_WEBHOOK_KEY||''); const supplied=String(headers['x-leadflow-key']||''); const authenticated=expected.length>0&&supplied.length===expected.length&&crypto.timingSafeEqual(Buffer.from(supplied),Buffer.from(expected)); if(!authenticated)return{json:{route:'auth_error',execution_id:executionId}}; const contentType=String(headers['content-type']||'').toLowerCase(); if(!contentType.startsWith('application/json'))return{json:{route:'validation_error',execution_id:executionId,error_code:'content_type'}}; let code='',eventId=null,source=null; if(!body||typeof body!=='object'||Array.isArray(body))code='invalid_json'; else{eventId=typeof body.event_id==='string'?body.event_id:null; source=typeof body.source==='string'?body.source:null; if(!Object.prototype.hasOwnProperty.call(body,'event_id')||!Object.prototype.hasOwnProperty.call(body,'source')||!Object.prototype.hasOwnProperty.call(body,'lead')||!body.lead||!Object.prototype.hasOwnProperty.call(body.lead,'email'))code='missing_field'; else if(typeof body.event_id!=='string'||typeof body.source!=='string'||typeof body.lead!=='object'||Array.isArray(body.lead)||typeof body.lead.email!=='string')code='invalid_type'; else if(body.event_id.length<1||body.event_id.length>200||body.event_id.trim()!==body.event_id)code='invalid_event_id'; else if(body.source.length<1||body.source.length>100||!/^[A-Za-z0-9_-]+$/.test(body.source))code='invalid_source'; else{const email=body.lead.email.trim().toLowerCase(); const parts=email.split('@'); const labels=parts.length===2?parts[1].split('.'):[]; if(email.length>254||/\\s/.test(email)||parts.length!==2||!parts[0]||labels.length<2||labels.some(label=>!label))code='invalid_email'; else{for(const field of ['first_name','last_name','phone','company'])if(Object.prototype.hasOwnProperty.call(body.lead,field)&&(typeof body.lead[field]!=='string'||body.lead[field].length>200))code='invalid_optional_field'; if(!code){const sha=value=>crypto.createHash('sha256').update(value,'utf8').digest('hex'); const lead={email},crm_fields={}; for(const field of ['first_name','last_name','phone','company'])if(body.lead[field]){lead[field]=body.lead[field];crm_fields[field]=body.lead[field];} return{json:{route:'valid',execution_id:executionId,event_id:body.event_id,source:body.source,lead_identifier:sha(email),idempotency_key:sha(body.source+':'+body.event_id),email,lead,crm_fields}};}}}} return{json:{route:'validation_error',execution_id:executionId,event_id:eventId,source,error_code:code}};"
      }
